name = "klaseca/skerry"

version = "0.0.0"

readme = "README.mbt.md"

repository = "https://github.com/klaseca/skerry"

license = "Apache-2.0"

keywords = [ "ui", "desktop", "sdl", "skia" ]

description = "Native desktop UI framework for MoonBit with SDL and Skia defaults"

preferred_target = "native"

supported_targets = "native"

import {
  "klaseca/sdl@0.3.2",
  "klaseca/sdl-sys@0.3.3",
  "klaseca/skia@0.2.2",
  "klaseca/skia-sys@0.2.1",
  "mizchi/css@0.8.2",
  "mizchi/crater-core@0.19.0",
  "mizchi/crater-layout@0.19.1",
  "mizchi/signals@0.6.6",
  "moonbitlang/x@0.5.6",
}

source = "src"
